{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill_id",
    "title",
    "goal",
    "summary",
    "preconditions",
    "policy_steps",
    "stop_conditions",
    "failure_modes",
    "exceptions",
    "dependencies",
    "claims",
    "insufficient_evidence"
  ],
  "properties": {
    "skill_id": {"type": "string"},
    "title": {"type": "string"},
    "goal": {"type": "string"},
    "summary": {"type": "string"},
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "evidence_ids"],
        "properties": {
          "condition": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "policy_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instruction", "evidence_ids"],
        "properties": {
          "instruction": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition", "evidence_ids"],
        "properties": {
          "condition": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symptom", "recovery", "evidence_ids"],
        "properties": {
          "symptom": {"type": "string"},
          "recovery": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "evidence_ids"],
        "properties": {
          "description": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["goal", "evidence_ids"],
        "properties": {
          "goal": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "supporting_evidence_ids",
          "contradicting_evidence_ids",
          "confidence"
        ],
        "properties": {
          "text": {"type": "string"},
          "supporting_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "contradicting_evidence_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "insufficient_evidence": {"type": "array", "items": {"type": "string"}}
  }
}
